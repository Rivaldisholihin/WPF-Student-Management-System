<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System"
        Width="1200"
        Height="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1565C0"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="STUDENT MANAGEMENT SYSTEM"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Manage student data"
                           Foreground="White"
                           FontSize="14"
                           Opacity="0.85"/>

            </StackPanel>

        </Border>

        <!-- STATISTIK -->
        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="5"
                    Padding="15"
                    Background="#E3F2FD"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="TOTAL MAHASISWA"
                               FontSize="12"/>

                    <TextBlock Text="{Binding TotalStudents}"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Margin="5"
                    Padding="15"
                    Background="#E8F5E9"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="INFORMATIKA"
                               FontSize="12"/>

                    <TextBlock Text="{Binding TotalInformatika}"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Margin="5"
                    Padding="15"
                    Background="#FFF3E0"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="SISTEM INFORMASI"
                               FontSize="12"/>

                    <TextBlock Text="{Binding TotalSistemInformasi}"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="3"
                    Margin="5"
                    Padding="15"
                    Background="#F3E5F5"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="LAKI-LAKI"
                               FontSize="12"/>

                    <TextBlock Text="{Binding TotalLakiLaki}"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="4"
                    Margin="5"
                    Padding="15"
                    Background="#FCE4EC"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="PEREMPUAN"
                               FontSize="12"/>

                    <TextBlock Text="{Binding TotalPerempuan}"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

        </Grid>

        <!-- INPUT DAN SEARCH -->
        <Grid Grid.Row="2"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- INPUT MAHASISWA -->
            <Border Grid.Column="0"
                    Background="#F5F5F5"
                    Padding="15"
                    CornerRadius="8"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="INPUT MAHASISWA"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="NIM"/>

                    <TextBox Text="{Binding SelectedStudent.NIM,
                                             UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Nama"/>

                    <TextBox Text="{Binding SelectedStudent.Nama,
                                             UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Jurusan"/>

                    <ComboBox ItemsSource="{Binding JurusanOptions}"
                              SelectedItem="{Binding SelectedStudent.Jurusan,
                                                     Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Gender"/>

                    <ComboBox ItemsSource="{Binding GenderOptions}"
                              SelectedItem="{Binding SelectedStudent.Gender,
                                                     Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email"/>

                    <TextBox Text="{Binding SelectedStudent.Email,
                                             UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Simpan"
                                Command="{Binding SaveCommand}"
                                Background="#1976D2"
                                Foreground="White"/>

                        <Button Content="Reset"
                                Command="{Binding ResetCommand}"/>

                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Background="#D32F2F"
                                Foreground="White"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- SEARCH -->
            <Border Grid.Column="1"
                    Background="#F5F5F5"
                    Padding="15"
                    CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="SEARCH"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0"/>

                        <Button Grid.Column="1"
                                Content="Cari"
                                Command="{Binding SearchCommand}"
                                Padding="25,8"/>

                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent,
                                                     Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="NIM"
                                                Binding="{Binding NIM}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Nama"
                                                Binding="{Binding Nama}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Jurusan"
                                                Binding="{Binding Jurusan}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Gender"
                                                Binding="{Binding Gender}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="180"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

        <!-- DATA MAHASISWA -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="DATA MAHASISWA"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent,
                                                 Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="NIM"
                                            Binding="{Binding NIM}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Nama"
                                            Binding="{Binding Nama}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Jurusan"
                                            Binding="{Binding Jurusan}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Gender"
                                            Binding="{Binding Gender}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="220"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>